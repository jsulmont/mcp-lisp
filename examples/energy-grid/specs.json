{"entities":{"generator":{"name":"generator","supers":[],"fields":[{"name":"id","type":"string","required":true,"unique":true},{"name":"name","type":"string","required":true},{"name":"fuel-type","type":"(member :gas :coal :nuclear :hydro :wind :solar)","required":true},{"name":"state","type":"(member :offline :starting :online :stopping :tripped)","default":":offline"},{"name":"output-mw","type":"number","default":"0"},{"name":"min-output","type":"number","required":true},{"name":"max-output","type":"number","required":true},{"name":"ramp-rate","type":"number","required":true},{"name":"min-up-time","type":"number","required":true},{"name":"min-down-time","type":"number","required":true},{"name":"start-cost","type":"number","required":true},{"name":"marginal-cost","type":"number","required":true},{"name":"emissions-rate","type":"number","required":true},{"name":"intervals-in-state","type":"number","default":"0"}],"relations":[{"kind":"belongs-to","name":"grid-zone","of":"grid-zone"}],"derived":[{"name":"output-cost","expression":"(lambda (g) (* (getf g :output-mw) (getf g :marginal-cost) (/ 1.0 12)))"},{"name":"output-emissions","expression":"(lambda (g) (* (getf g :output-mw) (getf g :emissions-rate) (/ 1.0 12)))"},{"name":"can-increase","expression":"(lambda (g) (if (eq (getf g :state) :online) (min (- (getf g :max-output) (getf g :output-mw)) (* (getf g :ramp-rate) 5)) 0))"},{"name":"can-decrease","expression":"(lambda (g) (if (eq (getf g :state) :online) (min (- (getf g :output-mw) (getf g :min-output)) (* (getf g :ramp-rate) 5)) 0))"}]},"storage-unit":{"name":"storage-unit","supers":[],"fields":[{"name":"id","type":"string","required":true,"unique":true},{"name":"name","type":"string","required":true},{"name":"state","type":"(member :idle :charging :discharging)","default":":idle"},{"name":"capacity-mwh","type":"number","required":true},{"name":"soc","type":"number","required":true},{"name":"max-charge-rate","type":"number","required":true},{"name":"max-discharge-rate","type":"number","required":true},{"name":"current-rate","type":"number","default":"0"},{"name":"round-trip-efficiency","type":"number","required":true},{"name":"min-soc","type":"number","default":"0.1"},{"name":"max-soc","type":"number","default":"0.95"},{"name":"cycle-count","type":"number","default":"0"}],"relations":[{"kind":"belongs-to","name":"grid-zone","of":"grid-zone"}],"derived":[{"name":"available-energy","expression":"(lambda (s) (* (- (getf s :soc) (getf s :min-soc)) (getf s :capacity-mwh)))"},{"name":"available-capacity","expression":"(lambda (s) (* (- (getf s :max-soc) (getf s :soc)) (getf s :capacity-mwh)))"},{"name":"soc-after-interval","expression":"(lambda (s) (let* ((rate (getf s :current-rate)) (eff (if (< rate 0) (getf s :round-trip-efficiency) 1.0)) (delta (/ (* (- rate) eff) (* (getf s :capacity-mwh) 12)))) (+ (getf s :soc) delta)))"}]},"demand-response-contract":{"name":"demand-response-contract","supers":[],"fields":[{"name":"id","type":"string","required":true,"unique":true},{"name":"customer","type":"string","required":true},{"name":"priority-tier","type":"(member 1 2 3)","required":true},{"name":"curtailable-mw","type":"number","required":true},{"name":"activation-state","type":"(member :standby :notified :curtailed :restored)","default":":standby"},{"name":"min-notification-intervals","type":"number","required":true},{"name":"max-curtailment-intervals","type":"number","required":true},{"name":"intervals-in-state","type":"number","default":"0"},{"name":"compensation-rate","type":"number","required":true}],"relations":[{"kind":"belongs-to","name":"grid-zone","of":"grid-zone"}],"derived":[]},"grid-zone":{"name":"grid-zone","supers":[],"fields":[{"name":"id","type":"string","required":true,"unique":true},{"name":"name","type":"string","required":true},{"name":"demand-mw","type":"number","required":true},{"name":"demand-forecast-mw","type":"number","required":true},{"name":"frequency-hz","type":"number","default":"60.0"},{"name":"import-limit-mw","type":"number","required":true},{"name":"export-limit-mw","type":"number","required":true},{"name":"transfer-mw","type":"number","default":"0"}],"relations":[{"kind":"has-many","name":"generators","of":"generator"},{"kind":"has-many","name":"storage-units","of":"storage-unit"},{"kind":"has-many","name":"demand-response-contracts","of":"demand-response-contract"}],"derived":[]},"dispatch-interval":{"name":"dispatch-interval","supers":[],"fields":[{"name":"id","type":"string","required":true,"unique":true},{"name":"timestamp","type":"string","required":true},{"name":"state","type":"(member :pending :cleared :emergency :blackout)","default":":pending"},{"name":"total-demand-mw","type":"number","required":true},{"name":"total-generation-mw","type":"number","required":true},{"name":"total-storage-mw","type":"number","default":"0"},{"name":"total-curtailment-mw","type":"number","default":"0"},{"name":"system-imbalance-mw","type":"number","required":true},{"name":"system-frequency-hz","type":"number","default":"60.0"},{"name":"emissions-tons","type":"number","default":"0"},{"name":"total-cost","type":"number","default":"0"},{"name":"reserve-margin-pct","type":"number","default":"0"}],"relations":[],"derived":[]}},"rules":{"clear-dispatch":{"name":"clear-dispatch","when":"(dispatch-interval :state :pending)","requires":["(and (>= (dispatch-interval-system-imbalance-mw dispatch-interval) -50) (<= (dispatch-interval-system-imbalance-mw dispatch-interval) 50))","(and (>= (dispatch-interval-system-frequency-hz dispatch-interval) 59.95) (<= (dispatch-interval-system-frequency-hz dispatch-interval) 60.05))","(>= (dispatch-interval-reserve-margin-pct dispatch-interval) 15)"],"ensures":["(eq (dispatch-interval-state dispatch-interval) :cleared)"]},"declare-emergency":{"name":"declare-emergency","when":"(dispatch-interval :state :pending)","requires":["(or (< (dispatch-interval-reserve-margin-pct dispatch-interval) 7) (> (abs (dispatch-interval-system-imbalance-mw dispatch-interval)) 100))"],"ensures":["(eq (dispatch-interval-state dispatch-interval) :emergency)"]},"escalate-curtailment":{"name":"escalate-curtailment","when":"(dispatch-interval :state :emergency)","requires":["(< (dispatch-interval-system-imbalance-mw dispatch-interval) -50)"],"ensures":["(eq (dispatch-interval-state dispatch-interval) :emergency)"]},"declare-blackout":{"name":"declare-blackout","when":"(dispatch-interval :state :emergency)","requires":["(< (dispatch-interval-system-imbalance-mw dispatch-interval) -200)"],"ensures":["(eq (dispatch-interval-state dispatch-interval) :blackout)"]},"start-generator":{"name":"start-generator","when":"(generator :state :offline)","requires":["(>= (generator-intervals-in-state generator) (generator-min-down-time generator))"],"ensures":["(eq (generator-state generator) :starting)","(= (generator-output-mw generator) 0)"]},"sync-generator":{"name":"sync-generator","when":"(generator :state :starting)","requires":["(>= (generator-intervals-in-state generator) 2)"],"ensures":["(eq (generator-state generator) :online)","(= (generator-output-mw generator) (generator-min-output generator))"]},"trip-generator":{"name":"trip-generator","when":"(generator :state :online)","ensures":["(eq (generator-state generator) :tripped)","(= (generator-output-mw generator) 0)"]},"stop-generator":{"name":"stop-generator","when":"(generator :state :online)","requires":["(>= (generator-intervals-in-state generator) (generator-min-up-time generator))"],"ensures":["(eq (generator-state generator) :stopping)","(= (generator-output-mw generator) 0)"]},"ramp-generator":{"name":"ramp-generator","when":"(generator :state :online)","requires":["(>= (generator-output-mw generator) (generator-min-output generator))","(<= (generator-output-mw generator) (generator-max-output generator))"],"ensures":["(eq (generator-state generator) :online)"]}},"invariants":{"output-matches-state":{"name":"output-matches-state","on":"generator","check":"(if (not (eq (getf generator :state) :online)) (= (getf generator :output-mw) 0) t)"},"output-within-bounds":{"name":"output-within-bounds","on":"generator","check":"(if (eq (getf generator :state) :online) (and (>= (getf generator :output-mw) (getf generator :min-output)) (<= (getf generator :output-mw) (getf generator :max-output))) t)"},"positive-capacity":{"name":"positive-capacity","on":"generator","check":"(and (> (getf generator :max-output) 0) (>= (getf generator :min-output) 0) (< (getf generator :min-output) (getf generator :max-output)))"},"ramp-rate-positive":{"name":"ramp-rate-positive","on":"generator","check":"(> (getf generator :ramp-rate) 0)"},"min-times-positive":{"name":"min-times-positive","on":"generator","check":"(and (> (getf generator :min-up-time) 0) (> (getf generator :min-down-time) 0))"},"emissions-non-negative":{"name":"emissions-non-negative","on":"generator","check":"(and (>= (getf generator :emissions-rate) 0) (if (member (getf generator :fuel-type) (quote (:hydro :wind :solar))) (= (getf generator :emissions-rate) 0) (> (getf generator :emissions-rate) 0)))"},"nuclear-constraints":{"name":"nuclear-constraints","on":"generator","check":"(if (eq (getf generator :fuel-type) :nuclear) (and (>= (getf generator :min-up-time) 24) (>= (getf generator :min-down-time) 48) (>= (getf generator :min-output) (* 0.5 (getf generator :max-output)))) t)"},"soc-in-bounds":{"name":"soc-in-bounds","on":"storage-unit","check":"(and (>= (getf storage-unit :soc) (getf storage-unit :min-soc)) (<= (getf storage-unit :soc) (getf storage-unit :max-soc)))"},"rate-matches-state":{"name":"rate-matches-state","on":"storage-unit","check":"(or (and (eq (getf storage-unit :state) :idle) (= (getf storage-unit :current-rate) 0)) (and (eq (getf storage-unit :state) :charging) (< (getf storage-unit :current-rate) 0)) (and (eq (getf storage-unit :state) :discharging) (> (getf storage-unit :current-rate) 0)))"},"rate-within-limits":{"name":"rate-within-limits","on":"storage-unit","check":"(or (and (eq (getf storage-unit :state) :charging) (<= (abs (getf storage-unit :current-rate)) (getf storage-unit :max-charge-rate))) (and (eq (getf storage-unit :state) :discharging) (<= (getf storage-unit :current-rate) (getf storage-unit :max-discharge-rate))) (eq (getf storage-unit :state) :idle))"},"efficiency-valid":{"name":"efficiency-valid","on":"storage-unit","check":"(and (> (getf storage-unit :round-trip-efficiency) 0) (<= (getf storage-unit :round-trip-efficiency) 1.0))"},"soc-limits-ordered":{"name":"soc-limits-ordered","on":"storage-unit","check":"(and (>= (getf storage-unit :min-soc) 0) (< (getf storage-unit :min-soc) (getf storage-unit :max-soc)) (<= (getf storage-unit :max-soc) 1.0))"},"no-hunting":{"name":"no-hunting","on":"storage-unit","check":"(or (and (eq (getf storage-unit :state) :charging) (< (getf storage-unit :current-rate) 0)) (and (eq (getf storage-unit :state) :discharging) (> (getf storage-unit :current-rate) 0)) (and (eq (getf storage-unit :state) :idle) (= (getf storage-unit :current-rate) 0)))"},"soc-after-valid":{"name":"soc-after-valid","on":"storage-unit","check":"(and (>= (+ (getf storage-unit :soc) (/ (* (- (getf storage-unit :current-rate)) (if (< (getf storage-unit :current-rate) 0) (getf storage-unit :round-trip-efficiency) 1.0)) (* (getf storage-unit :capacity-mwh) 12))) (getf storage-unit :min-soc)) (<= (+ (getf storage-unit :soc) (/ (* (- (getf storage-unit :current-rate)) (if (< (getf storage-unit :current-rate) 0) (getf storage-unit :round-trip-efficiency) 1.0)) (* (getf storage-unit :capacity-mwh) 12))) (getf storage-unit :max-soc)))"},"curtailment-priority-order":{"name":"curtailment-priority-order","on":"demand-response-contract","check":"t"},"notification-respected":{"name":"notification-respected","on":"demand-response-contract","check":"(if (eq (getf demand-response-contract :activation-state) :curtailed) (>= (getf demand-response-contract :intervals-in-state) 0) t)"},"max-curtailment-duration":{"name":"max-curtailment-duration","on":"demand-response-contract","check":"(if (eq (getf demand-response-contract :activation-state) :curtailed) (<= (getf demand-response-contract :intervals-in-state) (getf demand-response-contract :max-curtailment-intervals)) t)"},"compensation-positive":{"name":"compensation-positive","on":"demand-response-contract","check":"(> (getf demand-response-contract :compensation-rate) 0)"},"cleared-means-balanced":{"name":"cleared-means-balanced","on":"dispatch-interval","check":"(if (eq (getf dispatch-interval :state) :cleared) (<= (abs (getf dispatch-interval :system-imbalance-mw)) 50) t)"},"frequency-reflects-imbalance":{"name":"frequency-reflects-imbalance","on":"dispatch-interval","check":"(<= (abs (- (getf dispatch-interval :system-frequency-hz) (+ 60.0 (* (getf dispatch-interval :system-imbalance-mw) 0.001)))) 0.001)"},"reserve-margin-sane":{"name":"reserve-margin-sane","on":"dispatch-interval","check":"(if (eq (getf dispatch-interval :state) :cleared) (>= (getf dispatch-interval :reserve-margin-pct) 15) t)"},"emergency-threshold":{"name":"emergency-threshold","on":"dispatch-interval","check":"(if (eq (getf dispatch-interval :state) :emergency) (or (< (getf dispatch-interval :reserve-margin-pct) 15) (> (abs (getf dispatch-interval :system-imbalance-mw)) 50)) t)"},"blackout-means-exhausted":{"name":"blackout-means-exhausted","on":"dispatch-interval","check":"(if (eq (getf dispatch-interval :state) :blackout) (and (> (getf dispatch-interval :total-curtailment-mw) 0) (= (getf dispatch-interval :reserve-margin-pct) 0)) t)"},"emissions-match":{"name":"emissions-match","on":"dispatch-interval","check":"(>= (getf dispatch-interval :emissions-tons) 0)"},"cost-match":{"name":"cost-match","on":"dispatch-interval","check":"(>= (getf dispatch-interval :total-cost) 0)"},"generation-totals-consistent":{"name":"generation-totals-consistent","on":"dispatch-interval","check":"(>= (getf dispatch-interval :total-generation-mw) 0)"},"transfer-limits-respected":{"name":"transfer-limits-respected","on":"grid-zone","check":"(let ((transfer (getf grid-zone :transfer-mw))) (if (> transfer 0) (<= transfer (getf grid-zone :import-limit-mw)) (<= (abs transfer) (getf grid-zone :export-limit-mw))))"},"transfer-net-zero":{"name":"transfer-net-zero","on":"grid-zone","check":"t"}}}
